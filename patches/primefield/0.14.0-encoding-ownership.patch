+#[cfg(test)]
+mod encoding_ownership_tests {
+    use super::{MontyFieldBytes, MontyFieldElement, MontyFieldParams};
+    use crate::{ByteOrder, compute_t};
+    use bigint::{ArrayEncoding, U384, const_prime_monty_params, modular::ConstMontyParams};
+    use ff::PrimeField;
+    use hybrid_array::typenum::U32;
+    use zeroize::{Zeroize, ZeroizeOnDrop, Zeroizing};
+
+    // The existing P-256 test field in wider storage exercises padding without
+    // introducing a new field modulus or multiplicative-generator assumption.
+    const_prime_monty_params!(
+        BigParams,
+        U384,
+        "00000000000000000000000000000000FFFFFFFF00000001000000000000000000000000FFFFFFFFFFFFFFFFFFFFFFFF",
+        6,
+        "Padded P-256 encoding regression field."
+    );
+    const_prime_monty_params!(
+        LittleParams,
+        U384,
+        "00000000000000000000000000000000FFFFFFFF00000001000000000000000000000000FFFFFFFFFFFFFFFFFFFFFFFF",
+        6,
+        "Padded P-256 encoding regression field."
+    );
+
+    impl MontyFieldParams<{ U384::LIMBS }> for BigParams {
+        type ByteSize = U32;
+        const BYTE_ORDER: ByteOrder = ByteOrder::BigEndian;
+        const MODULUS_HEX: &str =
+            "ffffffff00000001000000000000000000000000ffffffffffffffffffffffff";
+        const T: U384 = compute_t(Self::PARAMS.modulus().as_ref());
+    }
+
+    impl MontyFieldParams<{ U384::LIMBS }> for LittleParams {
+        type ByteSize = U32;
+        const BYTE_ORDER: ByteOrder = ByteOrder::LittleEndian;
+        const MODULUS_HEX: &str =
+            "ffffffff00000001000000000000000000000000ffffffffffffffffffffffff";
+        const T: U384 = compute_t(Self::PARAMS.modulus().as_ref());
+    }
+
+    type BigField = MontyFieldElement<BigParams, { U384::LIMBS }>;
+    type LittleField = MontyFieldElement<LittleParams, { U384::LIMBS }>;
+
+    #[test]
+    fn padded_big_endian_representations_preserve_all_low_sixteen_bit_patterns() {
+        for value in u16::MIN..=u16::MAX {
+            let mut bytes = MontyFieldBytes::<BigParams, { U384::LIMBS }>::default();
+            for (target, source) in bytes.iter_mut().rev().zip(value.to_be_bytes().iter().rev()) {
+                *target = *source;
+            }
+            let expected = BigField::from_u64(u64::from(value));
+            assert_eq!(BigField::from_bytes(&bytes).into_option(), Some(expected));
+            assert_eq!(BigField::from_slice(&bytes), Some(expected));
+            assert_eq!(BigField::from_repr(bytes).into_option(), Some(expected));
+            assert_eq!(expected.to_bytes(), bytes);
+        }
+    }
+
+    #[test]
+    fn padded_little_endian_representations_preserve_all_low_sixteen_bit_patterns() {
+        for value in u16::MIN..=u16::MAX {
+            let mut bytes = MontyFieldBytes::<LittleParams, { U384::LIMBS }>::default();
+            for (target, source) in bytes.iter_mut().zip(value.to_le_bytes().iter()) {
+                *target = *source;
+            }
+            let expected = LittleField::from_u64(u64::from(value));
+            assert_eq!(
+                LittleField::from_bytes(&bytes).into_option(),
+                Some(expected)
+            );
+            assert_eq!(LittleField::from_slice(&bytes), Some(expected));
+            assert_eq!(LittleField::from_repr(bytes).into_option(), Some(expected));
+            assert_eq!(expected.to_bytes(), bytes);
+        }
+    }
+
+    #[test]
+    fn padded_canonical_boundaries_are_checked_in_both_byte_orders() {
+        let cases = [
+            (
+                "00000000000000000000000000000000FFFFFFFF00000001000000000000000000000000FFFFFFFFFFFFFFFFFFFFFFFE",
+                true,
+            ),
+            (
+                "00000000000000000000000000000000FFFFFFFF00000001000000000000000000000000FFFFFFFFFFFFFFFFFFFFFFFF",
+                false,
+            ),
+            (
+                "00000000000000000000000000000000FFFFFFFF00000001000000000000000000000001000000000000000000000000",
+                false,
+            ),
+            (
+                "00000000000000000000000000000000FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF",
+                false,
+            ),
+        ];
+        for (hex, valid) in cases {
+            let integer = U384::from_be_hex(hex);
+            let big_padded = integer.to_be_byte_array();
+            let little_padded = integer.to_le_byte_array();
+            let mut big = MontyFieldBytes::<BigParams, { U384::LIMBS }>::default();
+            let mut little = MontyFieldBytes::<LittleParams, { U384::LIMBS }>::default();
+            for (target, source) in big.iter_mut().rev().zip(big_padded.iter().rev()) {
+                *target = *source;
+            }
+            for (target, source) in little.iter_mut().zip(little_padded.iter()) {
+                *target = *source;
+            }
+            assert_eq!(bool::from(BigField::from_bytes(&big).is_some()), valid);
+            assert_eq!(BigField::from_slice(&big).is_some(), valid);
+            assert_eq!(bool::from(BigField::from_repr(big).is_some()), valid);
+            assert_eq!(
+                bool::from(LittleField::from_bytes(&little).is_some()),
+                valid
+            );
+            assert_eq!(LittleField::from_slice(&little).is_some(), valid);
+            assert_eq!(bool::from(LittleField::from_repr(little).is_some()), valid);
+        }
+    }
+
+    #[test]
+    fn invalid_representation_lengths_fail_without_decoding() {
+        let invalid: &[&[u8]] = &[&[], &[1], &[1, 2, 3], &[0; 31], &[0; 33], &[0; 49]];
+        for bytes in invalid {
+            assert_eq!(BigField::from_slice(bytes), None);
+            assert_eq!(LittleField::from_slice(bytes), None);
+        }
+    }
+
+    #[test]
+    fn independent_guards_clear_integer_and_representation_storage() {
+        fn require_clearing_owner<T: ZeroizeOnDrop>() {}
+        require_clearing_owner::<Zeroizing<U384>>();
+        require_clearing_owner::<Zeroizing<MontyFieldBytes<BigParams, { U384::LIMBS }>>>();
+        let mut canonical = Zeroizing::new(U384::from_u64(0x1234));
+        let mut bytes = Zeroizing::new(BigField::from_u64(0x1234).to_bytes());
+        canonical.zeroize();
+        bytes.zeroize();
+        assert_eq!(*canonical, U384::ZERO);
+        assert!(bytes.iter().all(|byte| *byte == 0));
+    }
+}
