{
  "schema": 1,
  "lanes": {
    "policy": {
      "workflow": "release-readiness.yml"
    },
    "code": {
      "workflow": "rust-ci.yml",
      "paths": [
        "crates/",
        "packages/",
        "vectors/",
        "tools/",
        "gen/",
        "Package.swift",
        "Package.resolved",
        "deny.toml",
        "CONTRACT.md",
        "PROVIDER_POLICY.md",
        "SECURITY_MEMORY_MODEL.md",
        "docs/conformance.md",
        "docs/protobuf.md",
        "docs/rust-publishing.md"
      ]
    },
    "proto": {
      "workflow": "protobuf-ci.yml",
      "paths": [
        "crates/proto/",
        "crates/hpke/",
        "gen/",
        "packages/ts/src/proto/generated/"
      ]
    },
    "fuzz": {
      "workflow": "fuzz.yml",
      "paths": [
        "crates/",
        "fuzz/",
        "vectors/"
      ]
    },
    "formal": {
      "workflow": "formal-verification.yml",
      "paths": [
        "crates/aes-kw/",
        "crates/aes256-gcm-siv/",
        "crates/aes256-gcm/",
        "crates/chacha20-poly1305/",
        "crates/crypto/core/",
        "crates/crypto/dispatch/",
        "crates/crypto/src/operation_contract/",
        "crates/crypto/src/operations/",
        "crates/crypto/tests/ml_kem_public_key_validation_tests.rs",
        "crates/crypto/tests/restricted_operation_dispatch_tests.rs",
        "crates/ffi/",
        "crates/hpke/",
        "crates/ml-kem-1024/",
        "crates/ml-kem-512/",
        "crates/ml-kem-768/",
        "crates/p256/",
        "crates/proto/",
        "crates/secp256k1/",
        "crates/sha3-256/",
        "crates/sha3/",
        "crates/wasm/",
        "crates/x25519/",
        "crates/x448/",
        "formal/",
        "tools/external-vector-audit/",
        "vectors/external/hpke/",
        "vectors/external/nist-acvp/ml-kem/encap-decap/internalProjection.json",
        "vectors/external/provenance.json"
      ]
    }
  },
  "release": {
    "tagPrefix": "v",
    "crates": {
      "preflight": "crates-package-preflight.yml",
      "publish": "crates-release.yml",
      "artifacts": [
        "crate-archives-{version}-{sha}"
      ]
    },
    "swift": {
      "preflight": "swift-package-preflight.yml",
      "publish": "swift-package-release.yml",
      "artifacts": [
        "swift-xcframework-{version}-{sha}"
      ],
      "tagJob": "swift-release"
    },
    "npm": {
      "preflight": "npm-package-preflight.yml",
      "publish": "npm-package-release.yml",
      "artifacts": [
        "npm-tarball-{version}-{sha}"
      ],
      "manifests": [
        "packages/ts/package.json"
      ]
    },
    "maven": {
      "preflight": "kotlin-android-package-preflight.yml",
      "publish": "kotlin-android-package-release.yml",
      "artifacts": [
        "maven-jvm-{version}-{sha}",
        "maven-android-{version}-{sha}"
      ],
      "manifests": [
        "packages/kotlin/build.gradle.kts",
        "packages/kotlin-android/build.gradle.kts"
      ]
    }
  }
}
