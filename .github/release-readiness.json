{
  "schema": 1,
  "lanes": {
    "policy": {
      "workflow": "release-readiness.yml"
    },
    "code": {
      "workflow": "rust-ci.yml",
      "paths": [
        "crates/",
        "packages/",
        "vectors/",
        "tools/",
        "gen/",
        "Package.swift",
        "Package.resolved",
        "deny.toml",
        "CONTRACT.md",
        "PROVIDER_POLICY.md",
        "SECURITY_MEMORY_MODEL.md",
        "docs/conformance.md",
        "docs/protobuf.md",
        "docs/rust-publishing.md"
      ]
    },
    "proto": {
      "workflow": "protobuf-ci.yml",
      "paths": [
        "crates/proto/",
        "crates/hpke/",
        "gen/",
        "packages/ts/src/proto/generated/"
      ]
    },
    "fuzz": {
      "workflow": "fuzz.yml",
      "paths": [
        "crates/",
        "fuzz/",
        "vectors/"
      ]
    },
    "formal": {
      "workflow": "formal-verification.yml",
      "paths": [
        "crates/hpke/",
        "formal/",
        "tools/external-vector-audit/"
      ]
    }
  },
  "release": {
    "tagPrefix": "v",
    "crates": {
      "preflight": "crates-package-preflight.yml",
      "publish": "crates-release.yml",
      "artifacts": [
        "crate-archives-{version}-{sha}"
      ]
    },
    "swift": {
      "preflight": "swift-package-preflight.yml",
      "publish": "swift-package-release.yml",
      "artifacts": [
        "swift-xcframework-{version}-{sha}"
      ],
      "tagJob": "swift-release"
    },
    "npm": {
      "preflight": "npm-package-preflight.yml",
      "publish": "npm-package-release.yml",
      "artifacts": [
        "npm-tarball-{version}-{sha}"
      ],
      "manifests": [
        "packages/ts/package.json"
      ]
    },
    "maven": {
      "preflight": "kotlin-android-package-preflight.yml",
      "publish": "kotlin-android-package-release.yml",
      "artifacts": [
        "maven-jvm-{version}-{sha}",
        "maven-android-{version}-{sha}"
      ],
      "manifests": [
        "packages/kotlin/build.gradle.kts",
        "packages/kotlin-android/build.gradle.kts"
      ]
    }
  }
}
